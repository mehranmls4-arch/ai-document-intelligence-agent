# Database (SQLite by default for zero-setup local demo; swap to a Postgres
# connection string in production without changing any application code)
DATABASE_URL="file:./dev.db"

# --- AI provider ---------------------------------------------------------
# "mock"      -> deterministic, offline provider used for this portfolio demo
#                (no API key required, no external calls, no cost)
# "openai"    -> real OpenAI provider (requires OPENAI_API_KEY)
# "anthropic" -> real Anthropic provider (requires ANTHROPIC_API_KEY)
AI_PROVIDER="mock"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
AI_MODEL="gpt-4o-mini"

# --- Confidence / human-in-the-loop --------------------------------------
# Any field (or document classification) below this confidence is routed
# to the Review Queue instead of auto-completing.
REVIEW_CONFIDENCE_THRESHOLD="0.85"

# Tolerance (in currency units) allowed when checking
# subtotal + tax - discount = total, and quantity * unit_price = amount
VALIDATION_AMOUNT_TOLERANCE="0.02"

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_SIZE_MB="15"
UPLOAD_DIR="./storage/uploads"

# --- OCR --------------------------------------------------------------------
# Path to the system tesseract binary and poppler's pdftoppm/pdftotext.
# Leave as-is if they are on PATH (installed via apt: tesseract-ocr poppler-utils)
TESSERACT_BIN="tesseract"
PDFTOPPM_BIN="pdftoppm"
PDFTOTEXT_BIN="pdftotext"
